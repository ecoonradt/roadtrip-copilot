# Roadtrip Co-Pilot Route Builder — Local Environment Configuration
# Copy this file to .env:
#   cp .env.example .env

# Toggle authentication (default: false for local dev bypass)
# Set to 'true' to test Google OAuth2 and allowlist gating locally
AUTH_ENABLED=false

# Google OAuth 2.0 Web Client Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret key for HMAC-SHA256 signing of session and PKCE state cookies
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Authorized email allowlist (comma-separated, case-insensitive)
ALLOWED_EMAILS=

# Optional: Shared secret for CloudFront edge origin verification
# (Not required for local development; localhost and 127.0.0.1 are automatically trusted)
# ORIGIN_VERIFY_SECRET=

# Optional: Explicit public base URL override (defaults to request host/proto)
# PUBLIC_BASE_URL=

# Optional: Amazon S3 Bucket for cloud itinerary persistence (default: unset for local filesystem)
# Leave unset during local development to keep local routes in itineraries/*.json completely isolated from production S3
# S3_STORAGE_BUCKET=

# Optional: Google Places API (New) key for Route Scout place resolution (`resolve_and_standardize_place` tool)
# In cloud deployments, this is resolved from SSM parameter `/roadtrip-copilot/google-places-api-key`
GOOGLE_PLACES_API_KEY=

# Optional: Brave Search API key for Route Scout web grounding (`search_web` tool)
# In cloud deployments, this is resolved from SSM parameter `/roadtrip-copilot/brave-search-api-key`
BRAVE_SEARCH_API_KEY=
