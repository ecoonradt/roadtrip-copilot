{
  "name": "roadtrip-copilot-route-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -p tsconfig.json --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "npm run typecheck:app && npm run typecheck:tests",
    "typecheck:app": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.test.server.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:frontend": "vitest run src",
    "test:backend": "vitest run server",
    "test:browser": "playwright test",
    "refresh:pricing": "tsx server/lambdas/refreshBedrockPricing/handler.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1156.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1155.0",
    "@aws-sdk/client-pricing": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/client-ssm": "^3.1152.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.1.0",
    "google-auth-library": "^11.3.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-test-renderer": "18.3.1",
    "@types/tz-lookup": "^6.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.2",
    "postcss": "^8.4.49",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.0.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
