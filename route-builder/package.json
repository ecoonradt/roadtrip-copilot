{
  "name": "roadtrip-copilot-route-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -p tsconfig.json --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:backend": "vitest run tests/backend",
    "test:engine": "vitest run tests/engine",
    "test:ai": "vitest run tests/ai",
    "test:schema": "vitest run tests/engine/export.test.ts tests/backend/device.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1152.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.1.0",
    "google-auth-library": "^11.3.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-test-renderer": "18.3.1",
    "@types/tz-lookup": "^6.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vitest": "^2.1.8"
  }
}
